{% props
    product
%}

{% set id = product.id %}
{% set formData = {
    'redirectTo': 'frontend.detail.page',
    'redirectParameters': { productId: id }|json_encode,
    ("lineItems[#{id}][id]"): id,
    ("lineItems[#{id}][referencedId]"): id,
    ("lineItems[#{id}][type]"): 'product',
    ("lineItems[#{id}][stackable]"): '1',
    ("lineItems[#{id}][removable]"): '1',
    ("lineItems[#{id}][quantity]"): product.minPurchase,
    ("lineItems[#{id}][product-name]"): product.translated.name
} %}

{% if addToCartExtraFormData %}
    {% set formData = formData|merge(addToCartExtraFormData) %}
{% endif %}

<form
    action="{{ path('frontend.checkout.line-item.add') }}"
    method="post"
    class="sw-buy-button d-grid"
    data-add-to-cart="true"
>
    {% for name, value in formData %}
        <input
            type="hidden"
            name="{{ name }}"
            value="{{ value }}"
            {% if name == 'redirectParameters' %}
                data-redirect-parameters="true"
            {% endif %}
        >
    {% endfor %}

    <twig:Sw:Button variant="primary">
        {% block content %}{{ 'listing.boxAddProduct'|trans|sw_sanitize }}{% endblock %}
    </twig:Sw:Button>
</form>
