{% props
    productVariants = null,
%}

<div class="product-card-product-variants fs-6 d-flex flex-wrap text-light-emphasis">
    {%- for variant in productVariants -%}
        <span class="me-1">
            {{ variant.group }}: {{ variant.option }}{% if variants|last != variant %},{% endif %}
        </span>
    {%- endfor -%}
</div>
