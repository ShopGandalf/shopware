<aside class="sw-admin-menu">
    <div class="sw-admin-menu__header">
        <div>
            <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="36" height="36" rx="6" fill="#189EFF"/>
                <rect x="0.5" y="0.5" width="35" height="35" rx="5.5" stroke="black" stroke-opacity="0.05"/>
                <path d="M25.1376 27.3701C24.0954 26.5852 22.5582 25.9878 20.9316 25.3576C18.9953 24.6075 16.7997 23.755 15.1513 22.4446C13.2848 20.9575 12.3756 19.0823 12.3756 16.7122C12.3756 14.5841 13.2586 12.7656 14.9289 11.4508C16.8018 9.97687 19.6408 9.19628 23.136 9.19628C24.1019 9.19628 25.0242 9.25515 25.879 9.37289C25.9553 9.3838 26.0272 9.34237 26.0578 9.27478C26.0905 9.205 26.073 9.12433 26.0163 9.07418C23.8141 7.09217 20.9665 6.00195 18.0011 6.00195C14.7958 6.00195 11.7825 7.24916 9.51485 9.5168C7.24939 11.7823 6 14.7956 6 17.9987C6 21.2039 7.2472 24.2172 9.51485 26.4827C11.7803 28.7482 14.7937 29.9976 18.0011 29.9976C20.5914 29.9976 23.0575 29.1843 25.1354 27.6471C25.179 27.6144 25.2052 27.5642 25.2052 27.5097C25.2052 27.4552 25.1812 27.4029 25.1376 27.3701Z" fill="white"/>
                <path d="M29.9473 16.8906C29.943 16.8448 29.9211 16.8012 29.8863 16.7728C27.3831 14.6949 25.3575 13.8467 22.8958 13.8467C21.5832 13.8467 20.5758 14.1105 19.9043 14.6295C19.3221 15.0786 19.0146 15.7066 19.0146 16.4414C19.0146 18.5019 21.533 19.4417 24.4505 20.5297C25.9528 21.0901 27.5074 21.6701 28.9334 22.4616C28.9596 22.4768 28.9879 22.4834 29.0163 22.4834C29.0359 22.4834 29.0555 22.479 29.0751 22.4725C29.1209 22.455 29.1602 22.4201 29.1776 22.3722C29.7227 20.9767 29.9996 19.5049 29.9996 17.9982C29.9975 17.645 29.9822 17.2721 29.9473 16.8906Z" fill="white"/>
            </svg>
        </div>

        <div>
            <mt-text weight="bold" size="xs">Acme Inc</mt-text>
            <mt-text size="2xs" color="color-text-secondary-default">Shopware Beyond</mt-text>
        </div>
    </div>

    <div class="sw-admin-menu__navigation">
        <RovingFocusGroup as="div">
            <ul class="sw-admin-menu__modules">
                <li
                    v-for="module in MODULES"
                    :key="module.id">
                    <RovingFocusItem as-child>
                    <router-link
                        :to="{ name: module.to }"
                        class="sw-admin-menu__nav-item"
                        :class="{
                            'router-link-active': module.match($route) === 'exact'
                        }">

                        <mt-icon
                            v-if="module.icon !== 'bolt'"
                            size="var(--scale-size-16)"
                            :name="`${module.match($route) === 'exact' || (!!module.children && module.children.some(subModule => subModule.match($route) !== 'none')) ? 'solid' : 'regular'}-${module.icon}`"
                            :color="module.match($route) === 'exact' ? 'var(--color-icon-brand-default)' : '#696A6E'"
                        />

                        <div v-else>
                            <svg v-if="module.match($route) === 'exact' || (!!module.children && module.children.some(subModule => subModule.match($route) !== 'none'))" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <g clip-path="url(#clip0_4236_206)">
                                    <path d="M14.2069 0.390283C14.4927 0.0188402 14.9991 -0.10494 15.4237 0.0934083C15.8481 0.291885 16.0779 0.759068 15.9765 1.21646L14.247 8.99966H19.9999C20.3892 8.99966 20.7432 9.2257 20.9071 9.57876C21.0709 9.93181 21.0148 10.348 20.7636 10.6452L9.76357 23.6452C9.4664 23.9964 8.9677 24.0996 8.55556 23.8952C8.14366 23.6907 7.92367 23.2318 8.02334 22.7829L9.75283 14.9997H4.9999C4.61897 14.9996 4.27072 14.7828 4.10244 14.4411C3.93456 14.0995 3.97504 13.692 4.20693 13.3903L14.2069 0.390283Z" :fill="module.match($route) === 'exact' ? 'var(--color-icon-brand-default)' : '#696A6E'" />
                                </g>
                                <defs>
                                    <clipPath id="clip0_4236_206">
                                        <rect width="24" height="24" fill="white"/>
                                    </clipPath>
                                </defs>
                            </svg>

                            <svg v-else width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <g clip-path="url(#clip0_4236_204)">
                                    <path d="M14.207 0.390602C14.4928 0.0190538 14.9992 -0.104739 15.4238 0.0937268C15.8483 0.292228 16.0781 0.759333 15.9766 1.21677L14.2471 8.99998H20C20.3893 8.99998 20.7434 9.2259 20.9072 9.57908C21.071 9.93216 21.0149 10.3483 20.7637 10.6455L9.76367 23.6455C9.4665 23.9967 8.9678 24.0999 8.55566 23.8955C8.14366 23.6911 7.92376 23.2322 8.02344 22.7832L9.75293 15H5C4.61903 15 4.27083 14.7832 4.10254 14.4414C3.93455 14.0998 3.9751 13.6924 4.20703 13.3906L14.207 0.390602ZM7.03125 13H11C11.3033 13 11.5905 13.1374 11.7803 13.374C11.97 13.6105 12.0423 13.9207 11.9766 14.2168L10.8555 19.2578L17.8437 11H13C12.6967 11 12.4095 10.8625 12.2197 10.626C12.03 10.3894 11.9577 10.0792 12.0234 9.78318L13.0459 5.17966L7.03125 13Z" fill="#696A6E"/>
                                </g>
                                <defs>
                                    <clipPath id="clip0_4236_204">
                                        <rect width="24" height="24" fill="white"/>
                                    </clipPath>
                                </defs>
                            </svg>
                        </div>

                        <span>{{ module.name }}</span>
                    </router-link>
                    </RovingFocusItem>

                    <ul v-if="module.hasOwnProperty('children') && (module.match($route) !== 'none' || !!module.children && module.children.some(subModule => subModule.match($route) !== 'none'))" style="position: relative; list-style: none">
                        <div style="position: absolute; width: 1px; background: var(--color-border-primary-default); height: calc(100% - 5px * 2); top: 50%; transform: translateY(-50%); left: 17.5px"></div>

                        <li v-for="subModule in module.children"
                            :key="subModule.id">
                            <RovingFocusItem as-child>
                            <router-link
                                    class="sw-admin-menu__nav-item"
                                    :class="{
                                        'router-link-active': subModule.match($route) === 'exact'
                                    }"
                                    :to="{ name: subModule.to }">
                                <div style="display: grid; place-items: center; width: var(--scale-size-16); height: var(--scale-size-26);">
                                    <MotionDiv :transition="{ type: 'spring', duration: 0.2, bounce: 0}" layoutId="some-element" v-if="subModule.match($route) === 'exact'" style="width: 9px; background: var(--color-border-brand-selected); border-radius: 999px; height: 100%; z-index: 1; border: 3px solid var(--admin-menu-item-background-selected)"></MotionDiv>
                                </div>

                                <span>{{ subModule.name }}</span>
                            </router-link>
                            </RovingFocusItem>
                        </li>
                    </ul>
                </li>
            </ul>
        </RovingFocusGroup>

        <div>
            <mt-text weight="medium"
                 size="xs"
                 color="color-text-secondary-default"
                 class="sw-admin-menu__sales-channel-heading"
            >
                Sales Channel
            </mt-text>

            <RovingFocusGroup as="ul" class="sw-admin-menu__sales-channel-list">
                <li v-for="salesChannel in salesChannels"
                    :key="salesChannel.id">
                    <RovingFocusItem as-child>
                    <router-link
                        class="sw-admin-menu__sales-channel"
                        :class="{
                            'router-link-active': isSalesChannelSelected(salesChannel.id)
                        }"
                        :to="{
                            name: 'sw.sales.channel.detail',
                            params: { id: salesChannel.id }
                        }">

                        <mt-icon
                             size="var(--scale-size-16)"
                             :name="`${isSalesChannelSelected(salesChannel.id) ? 'solid' : 'regular'}-dashboard`"
                             :color="isSalesChannelSelected(salesChannel.id) ? 'var(--color-icon-brand-default)' : '#696A6E'"
                        />

                        <span>{{ salesChannel.translated.name }}</span>
                    </router-link>
                    </RovingFocusItem>
                </li>
            </RovingFocusGroup>
        </div>
    </div>


    <div class="sw-admin-menu__dark-mode-section">
        <mt-switch v-model="isDarkMode" label="Dark mode" />

        <span class="sw-admin-menu__dark-mode-experimental-badge">
            Experimental
        </span>
    </div>

    <div>
        <PopoverRoot :open="showAccountMenu" @update:open="showAccountMenu = $event">
            <div style="margin-inline-start: -8px">
                <PopoverTrigger class="sw-admin-menu__account">
                    <div class="sw-admin-menu__avatar">
                        <span>JJ</span>
                    </div>

                    <div>
                        <mt-text size="xs" weight="semibold">Jennifer Johnson</mt-text>
                        <mt-text size="2xs">j.johnson@example.com</mt-text>
                    </div>

                    <div class="sw-admin-menu__account-arrows" aria-hidden="true">
                        <mt-icon name="regular-chevron-up-xxs" color="var(--color-icon-primary-default)" />
                        <mt-icon name="regular-chevron-down-xxs" color="var(--color-icon-primary-default)" />
                    </div>
                </PopoverTrigger>
            </div>

            <PopoverPortal>
                <PopoverContent :side-offset="8" side="top" class="sw-admin-menu__account-menu">
                    <div class="sw-admin-menu__account-menu-item-list">
                        <router-link @click="showAccountMenu = false" :to="{ name: 'sw.profile.index' }" :data-variant="$route.name.startsWith('sw.profile') ? 'selected' : 'primary'" class="sw-admin-menu__account-menu-item" href="/bar">
                            <mt-icon
                                :name="`${$route.name.startsWith('sw.profile') ? 'solid' : 'regular'}-user`"
                                :color="$route.name.startsWith('sw.profile') ? 'var(--color-icon-brand-default)' : 'var(--color-icon-primary-default)'"
                                size="14px"
                            />

                            <span>Profile settings</span>
                        </router-link>

                        <button class="sw-admin-menu__account-menu-item" data-variant="critical" @click="signOut">
                            <mt-icon
                                name="regular-sign-out"
                                color="var(--color-icon-critical-default)"
                                size="14px"
                            />

                            <span>Sign out</span>
                        </button>
                    </div>

                    <div class="sw-admin-menu__account-menu-footer">
                        <mt-text
                            size="2xs"
                            color="color-text-secondary-default">
                            Version: 6.7.1
                        </mt-text>
                    </div>
                </PopoverContent>
            </PopoverPortal>
        </PopoverRoot>
    </div>
</aside>
