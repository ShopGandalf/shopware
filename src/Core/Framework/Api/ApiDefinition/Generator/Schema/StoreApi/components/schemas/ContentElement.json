{
    "openapi": "3.1.0",
    "info": [],
    "paths": [],
    "components": {
        "schemas": {
            "ContentSlotContent": {
                "type": "object",
                "description": "Container for content elements within a named slot",
                "properties": {
                    "elements": {
                        "type": "array",
                        "items": { "$ref": "#/components/schemas/ContentElement" }
                    },
                    "apiAlias": {
                        "type": "string",
                        "enum": ["content_element_slot_content"]
                    }
                },
                "required": ["apiAlias", "elements"]
            },
            "ContentElement": {
                "type": "object",
                "description": "Content element node in layout tree",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique element identifier"
                    },
                    "component": {
                        "type": "string",
                        "description": "Element component type (e.g., Sw:Grid, Sw:Content:Text, Sw:Product:Card)"
                    },
                    "properties": {
                        "type": "object",
                        "description": "Element properties keyed by property name",
                        "additionalProperties": true
                    },
                    "slots": {
                        "description": "Named slots containing child elements",
                        "oneOf": [
                            {
                                "type": "array",
                                "maxItems": 0
                            },
                            {
                                "type": "object",
                                "additionalProperties": {
                                    "$ref": "#/components/schemas/ContentSlotContent"
                                }
                            }
                        ]
                    },
                    "format": {
                        "type": "object",
                        "description": "Responsive format settings per breakpoint (xs, sm, md, lg, xl, xxl)",
                        "properties": {
                            "display": {
                                "type": "object",
                                "description": "Visibility per breakpoint",
                                "additionalProperties": { "type": "boolean" }
                            },
                            "align-self": {
                                "type": "object",
                                "description": "Alignment on the cross axis per breakpoint",
                                "additionalProperties": { "type": "string" }
                            },
                            "justify-self": {
                                "type": "object",
                                "description": "Alignment on the main axis per breakpoint",
                                "additionalProperties": { "type": "string" }
                            },
                            "col-span": {
                                "type": "object",
                                "description": "Grid column span per breakpoint",
                                "additionalProperties": { "type": "integer", "minimum": 1 }
                            },
                            "row-span": {
                                "type": "object",
                                "description": "Grid row span per breakpoint",
                                "additionalProperties": { "type": "integer", "minimum": 1 }
                            },
                            "padding": {
                                "type": "object",
                                "description": "Inner spacing per breakpoint",
                                "additionalProperties": { "type": "string" }
                            },
                            "margin": {
                                "type": "object",
                                "description": "Outer spacing per breakpoint",
                                "additionalProperties": { "type": "string" }
                            }
                        },
                        "additionalProperties": true
                    },
                    "apiAlias": {
                        "type": "string",
                        "enum": ["content_element"]
                    }
                },
                "required": ["apiAlias", "id", "component"]
            }
        }
    }
}
